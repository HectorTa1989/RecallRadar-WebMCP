# Polar: use sandbox while developing, then switch to production.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=polar_pat_replace_me
POLAR_PRODUCT_ID=replace_with_subscription_product_uuid
POLAR_PRO_BENEFIT_ID=replace_with_feature_flag_benefit_uuid

# Comma-separated ChatGPT user IDs or emails. Admins bypass the paywall server-side.
ADMIN_USER_IDS=
ADMIN_EMAILS=you@example.com

# Canonical deployed origin used for Polar return URLs.
PUBLIC_APP_URL=http://localhost:3000

# Optional live agent. Keep this server-side; never prefix it with NEXT_PUBLIC_.
# Gemini keys can be created in Google AI Studio. Without one, the deterministic
# guided trace remains available for judging and local development.
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-3.7-flash
